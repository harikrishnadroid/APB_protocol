// BRAM slave



module bram(
  input clk,
  input en,
  input we,
  input [31:0] addr,
  input [31:0] write_data,
  output reg [31:0] read_data
);

  reg [31:0] mem [31:0];

  always @(posedge clk) begin
    
    if (en) begin
      if (we)
        mem[addr[4:0]] <= write_data;
     else
       read_data <= mem[addr[4:0]];
    end
  end

endmodule
